{
  "name": "ontimize-web-ngx-report",
  "version": "17.0.0-SNAPSHOT-0",
  "description": "Automatic reports implementation for Ontimize Web",
  "keywords": [
    "angular",
    "ontimize-web-ngx",
    "ontimize-web-ngx-report",
    "report"
  ],
  "author": "IMATIA S.L.",
  "repository": {
    "type": "git",
    "url": "git@github.com:OntimizeWeb/ontimize-web-ngx-report.git"
  },
  "license": "Apache-2.0",
  "main": "./bundles/ontimize-web-ngx-report.umd.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build ontimize-web-ngx-report && npm run copy-files",
    "build-prod": "ng build ontimize-web-ngx-report -c production && npm run copy-files",
    "copy-files": "copyfiles -u 3 node_modules/ngx-extended-pdf-viewer/assets/**/* dist/assets",
    "test": "ng test --code-coverage",
    "test-ci": "ng test --no-watch --code-coverage --browsers ChromeHeadless",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/cdk": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/material": "^17.3.0",
    "@angular/material-moment-adapter": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@angular/flex-layout": "npm:@ngbracket/ngx-layout@^17.0.1",
    "@ngbracket/ngx-layout": "^17.0.1",
    "moment": "^2.29.4",
    "ngx-extended-pdf-viewer": "^19.0.0",
    "ngx-skeleton-loader": "^8.0.0",
    "ontimize-web-ngx": "^15.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.0",
    "@angular-eslint/builder": "^17.0.0",
    "@angular-eslint/eslint-plugin": "^17.0.0",
    "@angular-eslint/eslint-plugin-template": "^17.0.0",
    "@angular-eslint/schematics": "^17.0.0",
    "@angular-eslint/template-parser": "^17.0.0",
    "@angular/cli": "^17.3.0",
    "@angular/compiler-cli": "^17.3.0",
    "@angular/language-service": "^17.3.0",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "copyfiles": "~2.2.0",
    "eslint": "^8.28.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "karma-sonarqube-unit-reporter": "0.0.23",
    "ng-packagr": "^17.3.0",
    "sonarqube-scanner": "^2.8.1",
    "ts-node": "~10.0.0",
    "typescript": "~5.2.2"
  }
}
